# Local zero-setup development:
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data

# Production-like PostgreSQL (set DATABASE_DRIVER=postgres):
DATABASE_URL=postgresql://media_app:local_media_password@127.0.0.1:54329/media_command
BETTER_AUTH_URL=http://127.0.0.1:3000
# Comma-separated, explicit browser origins allowed to submit auth requests.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Hostnames only (no scheme or port), for additional local development browsers/devices.
ALLOWED_DEV_ORIGINS=127.0.0.1,localhost
# Use inline with local PGlite. In production, run `npm run worker:crawl` as a separate process.
CRAWL_WORKER_MODE=inline
CRAWL_WORKER_INTERVAL_MS=5000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
