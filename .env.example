# Local zero-setup development:
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data

# Production-like PostgreSQL (set DATABASE_DRIVER=postgres):
DATABASE_URL=postgresql://media_app:local_media_password@127.0.0.1:54329/media_command
API_HOST=127.0.0.1
API_PORT=4000
BETTER_AUTH_URL=http://127.0.0.1:3000
# Comma-separated, explicit browser origins allowed to submit auth requests.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Hostnames only (no scheme or port), for additional local development browsers/devices.
ALLOWED_DEV_ORIGINS=127.0.0.1,localhost
CRAWL_WORKER_INTERVAL_MS=5000
# Full-page browser crawls can legitimately take several minutes.
CRAWL_WORKER_STALE_MS=5400000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional server-side Codex native executable override (absolute path).
# Leave unset to use the system PATH or the SDK's bundled native runtime.
# CODEX_EXECUTABLE=/usr/local/bin/codex
# Optional model available to the server's Codex account; otherwise use its configured default.
# CRAWLER_CODEX_MODEL=your-enabled-model

# Frontend-only settings:
BACKEND_URL=http://127.0.0.1:4000
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
# Public frontend origin used for absolute article canonical URLs and site sitemaps.
# Configure on the frontend host when deploying the sites publicly.
# PUBLIC_SITE_URL=https://news.example.com

# Bounded crawler construction / repair. Identical recipes stop early.
CRAWLER_BUILD_MAX_ATTEMPTS=3
CRAWLER_BUILD_MAX_REQUESTS=1100
CRAWLER_BUILD_TIMEOUT_MS=600000
CRAWLER_BUILD_PROBE_PAGES=12
CRAWLER_BUILD_MAX_SAMPLES=12
CRAWLER_BUILD_CACHE_BYTES=64000000

# Social ingestion uses fixed browser adapters; profiles are private credentials.
# Optional absolute browser path; installed Chrome/Edge/Chromium is detected otherwise.
# SOCIAL_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# Use one absolute private path for the API and Worker. Use an encrypted volume in production.
# SOCIAL_BROWSER_PROFILE_DIR=D:/private-media-state/social-browser
# Optional host GUI control from the super-admin panel; production defaults to disabled.
# The browser opens on the backend host, never on a remote visitor's computer.
# SOCIAL_BROWSER_INTERACTIVE_LOGIN=true
